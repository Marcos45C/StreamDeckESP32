<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StreamDeck.App.ViewModels"
        xmlns:entities="using:StreamDeck.Domain.Entities"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
        x:Class="StreamDeck.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="StreamDeck ESP32"
        Width="1100" Height="650"
        MinWidth="760" MinHeight="480"
        CanResize="True">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#18181B" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E22" />
        <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#202024" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1F" />
        <SolidColorBrush x:Key="ActiveItemBackgroundBrush" Color="#22262B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2B2B30" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4E4E7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E96" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF" />
        <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#6B6B70" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#E88A8A" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.SectionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.EmptyStateTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.EmptyStateMessage">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.SidebarAction">
            <Setter Property="Background" Value="{StaticResource ActiveItemBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource ActiveItemBackgroundBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#202024" />
        </Style>
        <Style Selector="TabStripItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="TabStripItem:selected">
            <Setter Property="Background" Value="{StaticResource ActiveItemBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TabStripItem:pointerover">
            <Setter Property="Background" Value="#202024" />
        </Style>
    </Window.Styles>

    <Grid Background="{StaticResource WindowBackgroundBrush}"
          ColumnDefinitions="210,*">

        <!-- A. Barra lateral izquierda (sin cambios respecto a la Etapa 6.1) -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="20,24,20,20">

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="{Binding AppName}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Panel de control" Classes="SectionLabel" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="PERFILES"
                               Classes="SectionLabel"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="+"
                            Command="{Binding CreateProfileCommand}"
                            Width="22" Height="22"
                            Padding="0"
                            FontSize="14"
                            FontWeight="Bold"
                            CornerRadius="4"
                            Background="{StaticResource ActiveItemBackgroundBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Crear perfil" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Cargando perfiles…"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,12,0,0"
                           IsVisible="{Binding IsLoading}" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,8,0,0"
                         IsVisible="{Binding !IsLoading}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:Profile">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       Padding="10,8" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,8,0,0">
                    <Button Content="Renombrar"
                            Command="{Binding RenameProfileCommand}"
                            Classes="SidebarAction"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Eliminar"
                            Command="{Binding DeleteProfileCommand}"
                            Classes="SidebarAction"
                            Background="#2E2125"
                            Foreground="{StaticResource DangerTextBrush}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                <Border Grid.Row="5"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0"
                        Margin="0,12,0,0">
                    <TextBlock Text="Más secciones próximamente"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>

            </Grid>
        </Border>

        <!-- Columna derecha: barra superior + (centro + panel derecho) -->
        <Grid Grid.Column="1" RowDefinitions="56,*">

            <!-- B. Barra superior (sin cambios) -->
            <Border Grid.Row="0"
                    Background="{StaticResource TopBarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" Margin="24,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentSectionName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusDisconnectedBrush}" />
                        <TextBlock Text="{Binding DeviceStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,260">

                <!-- C. Área central: ahora con administración de páginas -->
                <Border Grid.Column="0">
                    <Grid>

                        <!-- Estado: sin perfil seleccionado -->
                        <StackPanel IsVisible="{Binding !HasSelectedProfile}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    MaxWidth="360">
                            <TextBlock Text="{Binding CenterEmptyStateTitle}" Classes="EmptyStateTitle" />
                            <TextBlock Text="{Binding CenterEmptyStateMessage}" Classes="EmptyStateMessage" />
                        </StackPanel>

                        <!-- Estado: perfil seleccionado -> administración de páginas -->
                        <Grid IsVisible="{Binding HasSelectedProfile}"
                              RowDefinitions="Auto,Auto,*"
                              Margin="24">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <ScrollViewer Grid.Column="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <TabStrip ItemsSource="{Binding Pages}"
                                              SelectedItem="{Binding SelectedPage}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0">
                                        <TabStrip.ItemTemplate>
                                            <DataTemplate x:DataType="entities:Page">
                                                <TextBlock Text="{Binding Name}" FontSize="13" Padding="14,8" />
                                            </DataTemplate>
                                        </TabStrip.ItemTemplate>
                                    </TabStrip>
                                </ScrollViewer>

                                <Button Grid.Column="1"
                                        Content="+"
                                        Command="{Binding CreatePageCommand}"
                                        Width="28" Height="28"
                                        Padding="0"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        CornerRadius="4"
                                        Background="{StaticResource ActiveItemBackgroundBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Margin="8,0,0,0"
                                        ToolTip.Tip="Crear página" />
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,12,0,0">
                                <Button Content="Renombrar"
                                        Command="{Binding RenamePageCommand}"
                                        Classes="SidebarAction" />
                                <Button Content="Eliminar"
                                        Command="{Binding RemovePageCommand}"
                                        Classes="SidebarAction"
                                        Background="#2E2125"
                                        Foreground="{StaticResource DangerTextBrush}" />
                                <Button Content="←"
                                        Command="{Binding MovePageLeftCommand}"
                                        Classes="SidebarAction"
                                        Width="32" />
                                <Button Content="→"
                                        Command="{Binding MovePageRightCommand}"
                                        Classes="SidebarAction"
                                        Width="32" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                        MaxWidth="360">
                                <TextBlock Text="{Binding PageEmptyStateTitle}" Classes="EmptyStateTitle" />
                                <TextBlock Text="{Binding PageEmptyStateMessage}" Classes="EmptyStateMessage" />
                            </StackPanel>

                        </Grid>
                    </Grid>
                </Border>

                <!-- D. Panel derecho (sin cambios) -->
                <Border Grid.Column="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20"
                                Spacing="6">
                        <TextBlock Text="{Binding PropertiesEmptyStateTitle}"
                                   Classes="EmptyStateTitle"
                                   FontSize="13" />
                        <TextBlock Text="{Binding PropertiesEmptyStateMessage}"
                                   Classes="EmptyStateMessage" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>

</Window>